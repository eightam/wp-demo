{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Weiss", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Nachtblau", "color": "#14212B" },
				{ "slug": "accent-1", "name": "Signalorange", "color": "#E2541B" },
				{ "slug": "accent-2", "name": "Nebelblau", "color": "#E6EDF2" },
				{ "slug": "accent-3", "name": "Stahlblau", "color": "#1F4E6B" },
				{ "slug": "accent-4", "name": "Grau", "color": "#5B6770" },
				{ "slug": "accent-5", "name": "Papier", "color": "#F6F4EF" },
				{ "slug": "accent-6", "name": "Linie", "color": "color-mix(in srgb, currentColor 18%, transparent)" }
			],
			"gradients": [
				{ "slug": "stahl", "name": "Stahl", "gradient": "linear-gradient(135deg, #1F4E6B 0%, #14212B 100%)" },
				{ "slug": "abend", "name": "Abend", "gradient": "linear-gradient(135deg, #E2541B 0%, #7A2E4F 55%, #14212B 100%)" },
				{ "slug": "signal", "name": "Signal", "gradient": "linear-gradient(120deg, #F28C38 0%, #E2541B 100%)" },
				{ "slug": "nebel", "name": "Nebel", "gradient": "linear-gradient(180deg, #F6F4EF 0%, #E6EDF2 100%)" },
				{ "slug": "gletscher", "name": "Gletscher", "gradient": "linear-gradient(135deg, #A9C8D8 0%, #1F4E6B 100%)" }
			]
		},
		"layout": { "contentSize": "720px", "wideSize": "1240px" }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--manrope)" },
		"elements": {
			"heading": { "typography": { "fontWeight": "700", "letterSpacing": "-0.02em" } },
			"link": { "color": { "text": "var(--wp--preset--color--accent-3)" }, ":hover": { "color": { "text": "var(--wp--preset--color--accent-1)" } } },
			"button": {
				"color": { "background": "var(--wp--preset--color--accent-1)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "2px" },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--base)" } }
			}
		}
	}
}
