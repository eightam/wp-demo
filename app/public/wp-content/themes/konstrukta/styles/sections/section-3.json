{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"slug": "section-3",
	"title": "Signalorange",
	"blockTypes": [
		"core/group",
		"core/columns",
		"core/column"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|accent-1",
			"text": "var:preset|color|base"
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				},
				":hover": {
					"color": {
						"text": "currentColor"
					}
				}
			},
			"heading": {
				"color": {
					"text": "currentColor"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|contrast"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-5",
						"text": "var:preset|color|contrast"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "color-mix(in srgb, currentColor 30%, transparent)"
				}
			}
		}
	}
}